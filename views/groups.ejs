<%- include('partials/header') %>

<%
  const groupList = Array.isArray(groups) ? groups : [];
%>

<style>
  :root {
    --groups-green: #16a34a;
    --groups-green-dark: #15803d;
    --groups-green-soft: #dcfce7;
    --groups-blue: #2563eb;
    --groups-blue-soft: #dbeafe;
    --groups-red: #dc2626;
    --groups-text: #111827;
    --groups-muted: #6b7280;
    --groups-border: #e5e7eb;
    --groups-card: #ffffff;
    --groups-background: #f4f7fb;
  }

  body {
    background: var(--groups-background);
  }

  .groups-page,
  .groups-page *,
  .groups-page *::before,
  .groups-page *::after {
    box-sizing: border-box;
  }

  .groups-page {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 22px 18px 42px;
    color: var(--groups-text);
  }

  .groups-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
    padding: 24px;
    border: 1px solid rgba(22, 163, 74, 0.14);
    border-radius: 24px;
    background:
      radial-gradient(
        circle at top right,
        rgba(34, 197, 94, 0.16),
        transparent 38%
      ),
      linear-gradient(135deg, #ffffff, #f0fdf4);
    box-shadow: 0 14px 36px rgba(15, 23, 42, 0.06);
  }

  .groups-heading-label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 9px;
    padding: 6px 11px;
    border-radius: 999px;
    background: var(--groups-green-soft);
    color: var(--groups-green-dark);
    font-size: 13px;
    font-weight: 750;
  }

  .groups-heading h2 {
    margin: 0;
    font-size: clamp(29px, 5vw, 40px);
    line-height: 1.13;
    letter-spacing: -0.04em;
  }

  .groups-heading p {
    margin: 9px 0 0;
    color: var(--groups-muted);
    font-size: 15px;
    line-height: 1.55;
  }

  .groups-count {
    display: flex;
    min-width: 98px;
    min-height: 82px;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(22, 163, 74, 0.14);
    border-radius: 19px;
    background: rgba(255, 255, 255, 0.78);
  }

  .groups-count strong {
    color: var(--groups-green-dark);
    font-size: 28px;
    line-height: 1;
  }

  .groups-count span {
    margin-top: 7px;
    color: var(--groups-muted);
    font-size: 12px;
    font-weight: 650;
  }

  .groups-layout {
    display: grid;
    grid-template-columns: minmax(300px, 0.85fr) minmax(0, 1.45fr);
    gap: 18px;
    align-items: start;
  }

  .groups-panel {
    overflow: hidden;
    border: 1px solid var(--groups-border);
    border-radius: 23px;
    background: var(--groups-card);
    box-shadow: 0 13px 34px rgba(15, 23, 42, 0.055);
  }

  .groups-panel-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 21px 22px;
    border-bottom: 1px solid var(--groups-border);
  }

  .groups-panel-icon {
    display: grid;
    width: 43px;
    height: 43px;
    flex: 0 0 43px;
    place-items: center;
    border-radius: 14px;
    background: var(--groups-green-soft);
    font-size: 20px;
  }

  .groups-panel-header h3 {
    margin: 0;
    font-size: 19px;
    letter-spacing: -0.025em;
  }

  .groups-panel-header p {
    margin: 4px 0 0;
    color: var(--groups-muted);
    font-size: 13px;
  }

  .create-group-form {
    padding: 22px;
  }

  .group-field {
    display: block;
    margin-bottom: 18px;
  }

  .group-field-label {
    display: block;
    margin-bottom: 8px;
    color: var(--groups-text);
    font-size: 14px;
    font-weight: 750;
  }

  .group-input-wrap {
    position: relative;
  }

  .group-input-icon {
    position: absolute;
    top: 50%;
    left: 15px;
    z-index: 1;
    transform: translateY(-50%);
    font-size: 18px;
    pointer-events: none;
  }

  .group-input {
    display: block;
    width: 100%;
    height: 52px;
    padding: 0 15px 0 46px;
    border: 1px solid #d1d5db;
    outline: none;
    border-radius: 14px;
    background: #ffffff;
    color: var(--groups-text);
    font: inherit;
    font-size: 15px;
    transition:
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .group-input::placeholder {
    color: #9ca3af;
  }

  .group-input:focus {
    border-color: var(--groups-green);
    box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.11);
  }

  .group-field-help {
    display: flex;
    gap: 7px;
    margin: 9px 2px 0;
    color: var(--groups-muted);
    font-size: 12px;
    line-height: 1.5;
  }

  .create-group-button {
    display: inline-flex;
    width: 100%;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin-top: 2px;
    border: 0;
    border-radius: 15px;
    background: linear-gradient(
      135deg,
      var(--groups-green),
      var(--groups-green-dark)
    );
    color: #ffffff;
    font: inherit;
    font-size: 15px;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 12px 24px rgba(22, 163, 74, 0.23);
  }

  .create-group-button:active {
    transform: scale(0.99);
  }

  .telegram-guide {
    margin: 0 22px 22px;
    padding: 17px;
    border: 1px solid rgba(37, 99, 235, 0.14);
    border-radius: 17px;
    background: #eff6ff;
  }

  .telegram-guide-title {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 12px;
    color: #1d4ed8;
    font-size: 14px;
    font-weight: 800;
  }

  .telegram-guide ol {
    margin: 0;
    padding-left: 21px;
    color: #475569;
    font-size: 13px;
    line-height: 1.75;
  }

  .groups-list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 21px 22px 15px;
  }

  .groups-list-header h3 {
    margin: 0;
    font-size: 20px;
    letter-spacing: -0.025em;
  }

  .groups-list-badge {
    padding: 7px 11px;
    border-radius: 999px;
    background: var(--groups-green-soft);
    color: var(--groups-green-dark);
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
  }

  .group-search-wrap {
    position: relative;
    margin: 0 22px 18px;
  }

  .group-search-icon {
    position: absolute;
    top: 50%;
    left: 15px;
    transform: translateY(-50%);
    font-size: 17px;
    pointer-events: none;
  }

  .group-search {
    width: 100%;
    height: 48px;
    padding: 0 15px 0 44px;
    border: 1px solid var(--groups-border);
    outline: none;
    border-radius: 14px;
    background: #f9fafb;
    color: var(--groups-text);
    font: inherit;
    font-size: 14px;
  }

  .group-search:focus {
    border-color: var(--groups-green);
    background: #ffffff;
    box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.09);
  }

  .group-cards {
    display: grid;
    gap: 12px;
    padding: 0 22px 22px;
  }

  .group-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--groups-border);
    border-radius: 18px;
    background: #ffffff;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .group-card:hover {
    transform: translateY(-1px);
    border-color: rgba(22, 163, 74, 0.3);
    box-shadow: 0 12px 26px rgba(15, 23, 42, 0.07);
  }

  .group-card-link,
  .group-card-content {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 17px;
    color: inherit;
    text-decoration: none;
  }

  .group-card-avatar {
    display: grid;
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    place-items: center;
    border-radius: 15px;
    background: var(--groups-green-soft);
    color: var(--groups-green-dark);
    font-size: 21px;
  }

  .group-card-main {
    min-width: 0;
    flex: 1;
  }

  .group-card-name {
    display: block;
    margin: 0;
    overflow: hidden;
    color: var(--groups-text);
    font-size: 15px;
    font-weight: 800;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .group-card-id {
    display: block;
    margin-top: 6px;
    overflow: hidden;
    color: var(--groups-muted);
    font-size: 12px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .group-card-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 9px;
    color: var(--groups-green-dark);
    font-size: 12px;
    font-weight: 750;
  }

  .group-card-status::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
  }

  .group-card-status.inactive {
    color: var(--groups-red);
  }

  .group-card-status.inactive::before {
    background: var(--groups-red);
  }

  .group-card-arrow {
    display: grid;
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    place-items: center;
    border-radius: 11px;
    background: #f3f4f6;
    color: var(--groups-muted);
    font-size: 20px;
  }

  .groups-empty {
    display: grid;
    min-height: 275px;
    padding: 34px 22px;
    place-items: center;
    text-align: center;
  }

  .groups-empty-icon {
    display: grid;
    width: 72px;
    height: 72px;
    margin: 0 auto 16px;
    place-items: center;
    border-radius: 22px;
    background: var(--groups-green-soft);
    font-size: 31px;
  }

  .groups-empty h4 {
    margin: 0 0 8px;
    font-size: 18px;
  }

  .groups-empty p {
    max-width: 330px;
    margin: 0;
    color: var(--groups-muted);
    font-size: 14px;
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .groups-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .groups-page {
      padding: 15px 13px 35px;
    }

    .groups-heading {
      padding: 20px;
      border-radius: 21px;
    }

    .groups-heading h2 {
      font-size: 29px;
    }

    .groups-heading p {
      font-size: 14px;
    }

    .groups-count {
      min-width: 75px;
      min-height: 72px;
    }

    .groups-count strong {
      font-size: 24px;
    }

    .groups-panel {
      border-radius: 20px;
    }

    .groups-panel-header,
    .create-group-form {
      padding: 18px;
    }

    .telegram-guide {
      margin: 0 18px 18px;
    }

    .groups-list-header {
      padding: 18px 18px 14px;
    }

    .group-search-wrap {
      margin: 0 18px 15px;
    }

    .group-cards {
      gap: 10px;
      padding: 0 18px 18px;
    }

    .group-card-link,
    .group-card-content {
      padding: 15px;
    }
  }

  @media (max-width: 390px) {
    .groups-heading {
      align-items: flex-start;
    }

    .groups-count {
      min-width: 67px;
    }
  }
</style>

<main class="groups-page">
  <section class="groups-heading">
    <div>
      <div class="groups-heading-label">
        <span>●</span>
        Quản lý nhóm
      </div>

      <h2>Nhóm Telegram</h2>

      <p>
        Tạo nhóm mới, kết nối Telegram Chat ID và quản lý các nhóm hiện có.
      </p>
    </div>

    <div class="groups-count">
      <strong><%= groupList.length %></strong>
      <span>nhóm</span>
    </div>
  </section>

  <div class="groups-layout">
    <section class="groups-panel">
      <div class="groups-panel-header">
        <span class="groups-panel-icon">➕</span>

        <div>
          <h3>Tạo nhóm mới</h3>
          <p>Nhập thông tin nhóm Telegram.</p>
        </div>
      </div>

      <form
        class="create-group-form"
        id="createGroupForm"
        method="post"
      >
        <label class="group-field">
          <span class="group-field-label">Tên nhóm</span>

          <span class="group-input-wrap">
            <span class="group-input-icon">👥</span>

            <input
              class="group-input"
              id="groupNameInput"
              name="name"
              type="text"
              placeholder="Ví dụ: Nhóm Hà Nội"
              minlength="2"
              maxlength="100"
              autocomplete="off"
              required
            >
          </span>
        </label>

        <label class="group-field">
          <span class="group-field-label">Telegram Chat ID</span>

          <span class="group-input-wrap">
            <span class="group-input-icon">✈️</span>

            <input
              class="group-input"
              id="telegramChatInput"
              name="telegram_chat_id"
              type="text"
              inputmode="numeric"
              placeholder="-100xxxxxxxxxx"
              autocomplete="off"
              required
            >
          </span>

          <span class="group-field-help">
            <span>ℹ️</span>
            Chat ID nhóm Telegram thường bắt đầu bằng
            <strong>-100</strong>.
          </span>
        </label>

        <!-- Giữ tương thích với các tên biến backend khác nhau -->
        <input
          id="groupNameAlias"
          type="hidden"
          name="group_name"
          value=""
        >

        <input
          id="telegramGroupAlias"
          type="hidden"
          name="telegram_group_id"
          value=""
        >

        <input
          id="chatIdAlias"
          type="hidden"
          name="chat_id"
          value=""
        >

        <button class="create-group-button" type="submit">
          <span>＋</span>
          <span>Tạo nhóm</span>
        </button>
      </form>

      <div class="telegram-guide">
        <div class="telegram-guide-title">
          <span>✈️</span>
          Hướng dẫn lấy Telegram Chat ID
        </div>

        <ol>
          <li>Thêm bot vào nhóm Telegram.</li>
          <li>Gửi lệnh <strong>/id</strong> trong nhóm.</li>
          <li>Sao chép Chat ID bắt đầu bằng <strong>-100</strong>.</li>
        </ol>
      </div>
    </section>

    <section class="groups-panel">
      <div class="groups-list-header">
        <h3>Danh sách nhóm</h3>

        <span class="groups-list-badge">
          <%= groupList.length %> nhóm
        </span>
      </div>

      <% if (groupList.length) { %>
        <div class="group-search-wrap">
          <span class="group-search-icon">⌕</span>

          <input
            class="group-search"
            id="groupSearchInput"
            type="search"
            placeholder="Tìm tên nhóm hoặc Telegram ID..."
            autocomplete="off"
          >
        </div>

        <div class="group-cards" id="groupCards">
          <% groupList.forEach((group) => { %>
            <%
              const groupId = group.id || '';
              const groupName =
                group.name ||
                group.group_name ||
                'Chưa đặt tên';

              const telegramId =
                group.telegram_chat_id ||
                group.telegram_group_id ||
                group.chat_id ||
                'Chưa có Telegram ID';

              const isActive = group.active !== false;
              const searchValue =
                `${groupName} ${telegramId}`.toLowerCase();
            %>

            <article
              class="group-card"
              data-group-search="<%= searchValue %>"
            >
              <% if (groupId) { %>
                <a
                  class="group-card-link"
                  href="/admin/groups/<%= groupId %>"
                >
                  <span class="group-card-avatar">👥</span>

                  <span class="group-card-main">
                    <strong class="group-card-name">
                      <%= groupName %>
                    </strong>

                    <span class="group-card-id">
                      <%= telegramId %>
                    </span>

                    <span
                      class="group-card-status
                        <%= isActive ? '' : 'inactive' %>"
                    >
                      <%= isActive ? 'Hoạt động' : 'Tạm khóa' %>
                    </span>
                  </span>

                  <span class="group-card-arrow">›</span>
                </a>
              <% } else { %>
                <div class="group-card-content">
                  <span class="group-card-avatar">👥</span>

                  <span class="group-card-main">
                    <strong class="group-card-name">
                      <%= groupName %>
                    </strong>

                    <span class="group-card-id">
                      <%= telegramId %>
                    </span>

                    <span
                      class="group-card-status
                        <%= isActive ? '' : 'inactive' %>"
                    >
                      <%= isActive ? 'Hoạt động' : 'Tạm khóa' %>
                    </span>
                  </span>
                </div>
              <% } %>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="groups-empty">
          <div>
            <div class="groups-empty-icon">👥</div>

            <h4>Chưa có nhóm nào</h4>

            <p>
              Nhập tên nhóm và Telegram Chat ID ở biểu mẫu bên trên để tạo
              nhóm đầu tiên.
            </p>
          </div>
        </div>
      <% } %>
    </section>
  </div>
</main>

<script>
  (() => {
    const form = document.getElementById("createGroupForm");
    const nameInput = document.getElementById("groupNameInput");
    const telegramInput = document.getElementById("telegramChatInput");

    const nameAlias = document.getElementById("groupNameAlias");
    const telegramAlias =
      document.getElementById("telegramGroupAlias");
    const chatIdAlias = document.getElementById("chatIdAlias");

    if (form) {
      form.addEventListener("submit", () => {
        const groupName = nameInput.value.trim();
        const telegramId = telegramInput.value.trim();

        nameInput.value = groupName;
        telegramInput.value = telegramId;

        nameAlias.value = groupName;
        telegramAlias.value = telegramId;
        chatIdAlias.value = telegramId;
      });
    }

    const searchInput = document.getElementById("groupSearchInput");
    const groupCards = document.querySelectorAll("[data-group-search]");

    if (searchInput) {
      searchInput.addEventListener("input", () => {
        const keyword = searchInput.value.trim().toLowerCase();

        groupCards.forEach((card) => {
          const searchable =
            card.getAttribute("data-group-search") || "";

          card.hidden = !searchable.includes(keyword);
        });
      });
    }
  })();
</script>

<%- include('partials/footer') %>