<%- include('partials/header') %>

<section class="page-shell">
  <div class="page-heading">
    <div>
      <span class="eyebrow">QUẢN LÝ</span>
      <h1>Nhóm</h1>
      <p>Tạo nhóm và mở từng nhóm để nhập thu chi, lương.</p>
    </div>
  </div>

  <section class="two-column-layout">
    <article class="content-card form-card">
      <div class="card-heading">
        <div>
          <h2>Tạo nhóm mới</h2>
          <p>Phí rửa có thể để 0%.</p>
        </div>
      </div>
      <form method="post" action="/admin/groups" class="form-stack">
        <label>
          <span>Tên nhóm</span>
          <input type="text" name="name" required autocomplete="off">
        </label>
        <label>
          <span>Telegram Chat ID</span>
          <input type="text" name="telegram_chat_id" inputmode="text" placeholder="Có thể để trống">
        </label>
        <label>
          <span>Phần trăm rửa</span>
          <div class="input-suffix">
            <input type="number" name="wash_fee_percent" min="0" max="100" step="0.01" value="0" required>
            <span>%</span>
          </div>
        </label>
        <button class="button button-primary button-full" type="submit">Tạo nhóm</button>
      </form>
    </article>

    <article class="content-card">
      <div class="card-heading">
        <div>
          <h2>Danh sách nhóm</h2>
          <p><%= groups.length %> nhóm hiện có.</p>
        </div>
      </div>

      <% if (groups.length) { %>
        <label class="search-field">
          <span>⌕</span>
          <input type="search" placeholder="Tìm tên nhóm hoặc Chat ID" data-group-search>
        </label>
      <% } %>

      <% if (!groups.length) { %>
        <div class="empty-state">Chưa có nhóm.</div>
      <% } else { %>
        <div class="group-list">
          <% groups.forEach((group) => { %>
            <a class="group-item" href="/admin/groups/<%= group.id %>" data-group-item data-search-text="<%= `${group.name} ${group.telegram_chat_id || ''}`.toLowerCase() %>">
              <span class="group-avatar"><%= String(group.name).charAt(0).toUpperCase() %></span>
              <span class="group-copy">
                <strong><%= group.name %></strong>
                <small>ID: <%= group.telegram_chat_id || 'Chưa kết nối' %> • Phí rửa: <%= formatPercent(group.wash_fee_percent) %>%</small>
              </span>
              <span class="group-stats">
                <small>Còn lại</small>
                <strong><%= formatCurrency(Number(group.total_income || 0) - Number(group.total_expense || 0)) %></strong>
              </span>
            </a>
          <% }) %>
        </div>
      <% } %>
    </article>
  </section>
</section>

<%- include('partials/footer') %>
