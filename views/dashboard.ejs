<%- include('partials/header') %>

<section class="page-shell">
  <div class="page-heading">
    <div>
      <span class="eyebrow">HÔM NAY</span>
      <h1>Trang chủ</h1>
      <p>Tổng quan thu chi và hoạt động gần đây.</p>
    </div>
    <a class="button button-primary" href="/admin/groups">Quản lý nhóm</a>
  </div>

  <section class="summary-grid">
    <article class="summary-card income">
      <span>Tổng thu hôm nay</span>
      <strong><%= formatCurrency(stats.totalIncome) %></strong>
    </article>
    <article class="summary-card expense">
      <span>Tổng chi hôm nay</span>
      <strong><%= formatCurrency(stats.totalExpense) %></strong>
    </article>
    <article class="summary-card balance">
      <span>Còn lại hôm nay</span>
      <strong><%= formatCurrency(stats.balance) %></strong>
    </article>
    <article class="summary-card neutral">
      <span>Số nhóm</span>
      <strong><%= stats.groupCount %></strong>
    </article>
    <article class="summary-card neutral">
      <span>Số nhân viên</span>
      <strong><%= stats.employeeCount %></strong>
    </article>
    <article class="summary-card <%= health?.connected ? 'income' : 'expense' %>">
      <span>Database</span>
      <strong><%= health?.connected ? 'Đã kết nối' : 'Mất kết nối' %></strong>
    </article>
  </section>

  <section class="content-card">
    <div class="card-heading">
      <div>
        <h2>Giao dịch gần đây</h2>
        <p>10 giao dịch mới nhất trong hệ thống.</p>
      </div>
    </div>

    <% if (!stats.recentTransactions?.length) { %>
      <div class="empty-state">Chưa có giao dịch.</div>
    <% } else { %>
      <div class="transaction-list">
        <% stats.recentTransactions.forEach((transaction) => { %>
          <div class="transaction-item">
            <div class="transaction-icon <%= transaction.type %>"><%= transaction.type === 'income' ? '+' : '−' %></div>
            <div class="transaction-main">
              <strong><%= transaction.description %></strong>
              <small><%= transaction.group_name %> • <%= formatDate(transaction.transaction_date) %></small>
            </div>
            <strong class="money <%= transaction.type %>"><%= transaction.type === 'income' ? '+' : '-' %><%= formatCurrency(transaction.amount) %></strong>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>
</section>

<%- include('partials/footer') %>
