<%- include('partials/header') %>
<section class="page-header">
  <div>
    <h2>Lương - <%= overview.employee.name %></h2>
    <p><%= overview.employee.group_name %> • <%= overview.employee.role || 'Chưa có vai trò' %></p>
  </div>
  <a class="button secondary" href="/admin/groups/<%= overview.employee.group_id %>/employees">Quay lại nhân viên</a>
</section>

<section class="grid cards">
  <article class="card stat-card">
    <span>Lương ngày mặc định</span>
    <strong><%= formatCurrency(overview.employee.daily_rate) %></strong>
  </article>
  <article class="card stat-card">
    <span>Tổng lương</span>
    <strong><%= formatCurrency(overview.totals.totalSalary) %></strong>
  </article>
  <article class="card stat-card">
    <span>Tạm ứng</span>
    <strong><%= formatCurrency(overview.totals.totalAdvance) %></strong>
  </article>
  <article class="card stat-card">
    <span>Thực nhận</span>
    <strong><%= formatCurrency(overview.totals.netAmount) %></strong>
  </article>
</section>

<section class="grid two-columns">
  <article class="card">
    <h3>Thêm lương ngày</h3>
    <form method="post" action="/admin/employees/<%= overview.employee.id %>/salary/add" class="stack">
      <label>
        Số tiền
        <input type="number" name="amount" min="0" step="1000" placeholder="Để trống = lương ngày mặc định" />
      </label>
      <label>
        Ngày làm
        <input type="date" name="work_date" value="<%= toDateInputValue() %>" />
      </label>
      <label>
        Ghi chú
        <textarea name="note" rows="2"></textarea>
      </label>
      <button class="button" type="submit">Thêm lương</button>
    </form>
  </article>

  <article class="card">
    <h3>Ứng lương</h3>
    <form method="post" action="/admin/employees/<%= overview.employee.id %>/salary/advance" class="stack">
      <label>
        Số tiền
        <input type="number" name="amount" min="0" step="1000" required />
      </label>
      <label>
        Ngày ứng
        <input type="date" name="advance_date" value="<%= toDateInputValue() %>" />
      </label>
      <label>
        Ghi chú
        <textarea name="note" rows="2"></textarea>
      </label>
      <button class="button" type="submit">Lưu ứng lương</button>
    </form>
  </article>
</section>

<section class="grid two-columns">
  <article class="card">
    <h3>Chốt lương ngày</h3>
    <form method="post" action="/admin/employees/<%= overview.employee.id %>/salary/close-day" class="stack">
      <label>
        Ngày chốt
        <input type="date" name="closing_date" value="<%= toDateInputValue() %>" />
      </label>
      <label>
        Ghi chú
        <textarea name="note" rows="2"></textarea>
      </label>
      <button class="button" type="submit">Chốt ngày</button>
    </form>
  </article>

  <article class="card">
    <h3>Chốt lương tháng</h3>
    <form method="post" action="/admin/employees/<%= overview.employee.id %>/salary/close-month" class="stack">
      <label>
        Tháng chốt
        <input type="month" name="closing_month" value="<%= toMonthInputValue() %>" />
      </label>
      <label>
        Ghi chú
        <textarea name="note" rows="2"></textarea>
      </label>
      <button class="button" type="submit">Chốt tháng</button>
    </form>
  </article>
</section>

<section class="grid two-columns">
  <article class="card">
    <h3>Lịch sử lương</h3>
    <% if (!overview.entries.length) { %>
      <p>Chưa có dòng lương nào.</p>
    <% } else { %>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Ngày</th>
              <th>Số tiền</th>
              <th>Ghi chú</th>
            </tr>
          </thead>
          <tbody>
            <% overview.entries.forEach((entry) => { %>
              <tr>
                <td><%= formatDate(entry.work_date) %></td>
                <td><%= formatCurrency(entry.amount) %></td>
                <td><%= entry.note || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </article>

  <article class="card">
    <h3>Lịch sử ứng lương</h3>
    <% if (!overview.advances.length) { %>
      <p>Chưa có dòng ứng lương nào.</p>
    <% } else { %>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Ngày</th>
              <th>Số tiền</th>
              <th>Ghi chú</th>
            </tr>
          </thead>
          <tbody>
            <% overview.advances.forEach((entry) => { %>
              <tr>
                <td><%= formatDate(entry.advance_date) %></td>
                <td><%= formatCurrency(entry.amount) %></td>
                <td><%= entry.note || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </article>
</section>

<section class="grid two-columns">
  <article class="card">
    <h3>Chốt lương ngày gần đây</h3>
    <% if (!overview.dailyClosings.length) { %>
      <p>Chưa có chốt ngày.</p>
    <% } else { %>
      <div class="list compact">
        <% overview.dailyClosings.forEach((closing) => { %>
          <div class="list-item static">
            <div>
              <strong><%= formatDate(closing.closing_date) %></strong>
              <small>Tạm ứng: <%= formatCurrency(closing.total_advance) %></small>
            </div>
            <span><%= formatCurrency(closing.net_amount) %></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </article>

  <article class="card">
    <h3>Chốt lương tháng gần đây</h3>
    <% if (!overview.monthlyClosings.length) { %>
      <p>Chưa có chốt tháng.</p>
    <% } else { %>
      <div class="list compact">
        <% overview.monthlyClosings.forEach((closing) => { %>
          <div class="list-item static">
            <div>
              <strong><%= formatMonth(closing.closing_month) %></strong>
              <small>Tạm ứng: <%= formatCurrency(closing.total_advance) %></small>
            </div>
            <span><%= formatCurrency(closing.net_amount) %></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </article>
</section>
<%- include('partials/footer') %>
