<%- include('partials/header') %>

<%
  const disconnected = health === false || health?.connected === false || health?.success === false || health?.database === 'disconnected';
%>

<section class="page-shell">
  <div class="page-heading">
    <div>
      <span class="eyebrow">HỆ THỐNG</span>
      <h1>Cài đặt</h1>
      <p>Kiểm tra cấu hình đang sử dụng.</p>
    </div>
  </div>

  <section class="two-column-layout">
    <article class="content-card">
      <div class="card-heading"><div><h2>Cấu hình</h2><p>Không hiển thị mật khẩu hoặc token.</p></div></div>
      <div class="settings-list">
        <div><span>PORT</span><strong><%= settings.port %></strong></div>
        <div><span>DATABASE_URL</span><strong class="<%= settings.hasDatabaseUrl ? 'status-ok' : 'status-bad' %>"><%= settings.hasDatabaseUrl ? 'Đã cấu hình' : 'Chưa cấu hình' %></strong></div>
        <div><span>DATABASE_SSL</span><strong><%= settings.databaseSsl %></strong></div>
        <div><span>BOT_TOKEN</span><strong class="<%= settings.hasBotToken ? 'status-ok' : 'status-bad' %>"><%= settings.hasBotToken ? 'Đã cấu hình' : 'Chưa cấu hình' %></strong></div>
        <div><span>ADMIN_USERNAME</span><strong><%= settings.adminUsername %></strong></div>
      </div>
    </article>

    <article class="content-card">
      <div class="card-heading"><div><h2>Trạng thái database</h2><p>Kết nối PostgreSQL hiện tại.</p></div></div>
      <div class="health-box <%= disconnected ? 'bad' : 'good' %>">
        <span class="health-dot"></span>
        <div><small>Trạng thái</small><strong><%= disconnected ? 'Mất kết nối' : 'Đã kết nối' %></strong></div>
      </div>
      <a class="button button-secondary button-full" href="/health" target="_blank" rel="noopener">Mở kiểm tra /health</a>
    </article>
  </section>
</section>

<%- include('partials/footer') %>
