<%- include('partials/header') %>

<%
  const currentSettings =
    typeof settings !== "undefined" && settings
      ? settings
      : {};

  const port =
    currentSettings.port || "8080";

  const databaseSsl =
    currentSettings.databaseSsl ?? "false";

  const databaseUrl =
    Boolean(currentSettings.hasDatabaseUrl);

  const botToken =
    Boolean(currentSettings.hasBotToken);

  const adminUsername =
    currentSettings.adminUsername || "(chưa set)";

  const databaseConnected =
    typeof health !== "undefined" &&
    health &&
    health.connected;

  const databaseMessage =
    typeof health !== "undefined" &&
    health &&
    health.message
      ? health.message
      : "Chưa có thông tin kiểm tra.";
%>

<style>
  .settings-page,
  .settings-page *,
  .settings-page *::before,
  .settings-page *::after {
    box-sizing: border-box;
  }

  .settings-page {
    --green: #16a34a;
    --green-dark: #15803d;
    --green-soft: #dcfce7;
    --red: #dc2626;
    --red-soft: #fee2e2;
    --text: #111827;
    --muted: #6b7280;
    --border: #e5e7eb;

    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 22px 18px 42px;
    color: var(--text);
  }

  .settings-hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
    padding: 24px;
    border: 1px solid rgba(22, 163, 74, 0.14);
    border-radius: 24px;
    background:
      radial-gradient(
        circle at top right,
        rgba(34, 197, 94, 0.17),
        transparent 38%
      ),
      linear-gradient(135deg, #ffffff, #f0fdf4);
    box-shadow: 0 14px 36px rgba(15, 23, 42, 0.06);
  }

  .settings-hero-label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 9px;
    padding: 6px 11px;
    border-radius: 999px;
    background: var(--green-soft);
    color: var(--green-dark);
    font-size: 13px;
    font-weight: 750;
  }

  .settings-hero h2 {
    margin: 0;
    font-size: clamp(29px, 5vw, 40px);
    line-height: 1.13;
    letter-spacing: -0.04em;
  }

  .settings-hero p {
    margin: 9px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }

  .settings-hero-icon {
    display: grid;
    width: 82px;
    height: 82px;
    flex: 0 0 82px;
    place-items: center;
    border: 1px solid rgba(22, 163, 74, 0.13);
    border-radius: 23px;
    background: rgba(255, 255, 255, 0.78);
    font-size: 38px;
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.06);
  }

  .settings-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(290px, 0.75fr);
    gap: 18px;
    align-items: start;
  }

  .settings-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 23px;
    background: #ffffff;
    box-shadow: 0 13px 34px rgba(15, 23, 42, 0.055);
  }

  .settings-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 21px 22px;
    border-bottom: 1px solid var(--border);
  }

  .settings-card-icon {
    display: grid;
    width: 43px;
    height: 43px;
    flex: 0 0 43px;
    place-items: center;
    border-radius: 14px;
    background: var(--green-soft);
    font-size: 20px;
  }

  .settings-card-header h3 {
    margin: 0;
    font-size: 19px;
    letter-spacing: -0.025em;
  }

  .settings-card-header p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 13px;
  }

  .settings-list {
    padding: 7px 22px 15px;
  }

  .settings-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-height: 75px;
    padding: 15px 0;
    border-bottom: 1px solid #eef1f4;
  }

  .settings-row:last-child {
    border-bottom: 0;
  }

  .settings-row-left {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 13px;
  }

  .settings-row-icon {
    display: grid;
    width: 39px;
    height: 39px;
    flex: 0 0 39px;
    place-items: center;
    border-radius: 12px;
    background: #f3f4f6;
    font-size: 17px;
  }

  .settings-row-title {
    display: block;
    color: var(--text);
    font-size: 14px;
    font-weight: 750;
  }

  .settings-row-description {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.4;
  }

  .settings-value {
    max-width: 48%;
    padding: 7px 11px;
    overflow: hidden;
    border-radius: 999px;
    background: #f3f4f6;
    color: #374151;
    font-size: 13px;
    font-weight: 800;
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .settings-value.configured {
    background: var(--green-soft);
    color: var(--green-dark);
  }

  .settings-value.warning {
    background: var(--red-soft);
    color: var(--red);
  }

  .health-content {
    padding: 22px;
  }

  .health-status {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 17px;
    border: 1px solid rgba(22, 163, 74, 0.18);
    border-radius: 17px;
    background: #f0fdf4;
  }

  .health-status.disconnected {
    border-color: rgba(220, 38, 38, 0.18);
    background: #fff1f2;
  }

  .health-dot {
    width: 13px;
    height: 13px;
    flex: 0 0 13px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 6px rgba(34, 197, 94, 0.13);
  }

  .health-status.disconnected .health-dot {
    background: var(--red);
    box-shadow: 0 0 0 6px rgba(220, 38, 38, 0.11);
  }

  .health-label {
    display: block;
    color: var(--muted);
    font-size: 12px;
    font-weight: 650;
  }

  .health-value {
    display: block;
    margin-top: 3px;
    color: var(--green-dark);
    font-size: 19px;
    font-weight: 850;
  }

  .health-status.disconnected .health-value {
    color: var(--red);
  }

  .health-message {
    margin: 18px 0 0;
    color: #475569;
    font-size: 14px;
    line-height: 1.6;
  }

  .health-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 18px;
    padding: 15px 16px;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: #f9fafb;
    color: var(--text);
    text-decoration: none;
  }

  .health-link span {
    font-size: 13px;
    font-weight: 750;
  }

  .health-link code {
    padding: 5px 8px;
    border-radius: 8px;
    background: #dbeafe;
    color: #2563eb;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
  }

  .settings-note {
    margin-top: 16px;
    padding: 15px;
    border-radius: 15px;
    background: #fffbeb;
    color: #92400e;
    font-size: 12px;
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .settings-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .settings-page {
      padding: 15px 13px 35px;
    }

    .settings-hero {
      padding: 20px;
      border-radius: 21px;
    }

    .settings-hero h2 {
      font-size: 29px;
    }

    .settings-hero p {
      font-size: 14px;
    }

    .settings-hero-icon {
      width: 67px;
      height: 67px;
      flex-basis: 67px;
      border-radius: 19px;
      font-size: 31px;
    }

    .settings-card {
      border-radius: 20px;
    }

    .settings-card-header {
      padding: 18px;
    }

    .settings-list {
      padding: 5px 18px 13px;
    }

    .settings-row {
      gap: 10px;
      min-height: 70px;
    }

    .settings-row-icon {
      width: 36px;
      height: 36px;
      flex-basis: 36px;
    }

    .settings-value {
      max-width: 45%;
      font-size: 12px;
    }

    .health-content {
      padding: 18px;
    }
  }

  @media (max-width: 390px) {
    .settings-hero-icon {
      display: none;
    }

    .settings-row-description {
      display: none;
    }

    .settings-value {
      max-width: 43%;
    }
  }
</style>

<div class="settings-page">
  <section class="settings-hero">
    <div>
      <div class="settings-hero-label">
        <span>●</span>
        Cài đặt hệ thống
      </div>

      <h2>Settings</h2>

      <p>
        Kiểm tra nhanh các biến môi trường và trạng thái kết nối hiện tại.
      </p>
    </div>

    <div class="settings-hero-icon">
      ⚙️
    </div>
  </section>

  <section class="settings-grid">
    <article class="settings-card">
      <div class="settings-card-header">
        <div class="settings-card-icon">⚙️</div>

        <div>
          <h3>Cấu hình</h3>
          <p>Thông tin môi trường đang sử dụng.</p>
        </div>
      </div>

      <div class="settings-list">
        <div class="settings-row">
          <div class="settings-row-left">
            <div class="settings-row-icon">🔌</div>

            <div>
              <span class="settings-row-title">PORT</span>
              <span class="settings-row-description">
                Cổng máy chủ ứng dụng
              </span>
            </div>
          </div>

          <strong class="settings-value">
            <%= port %>
          </strong>
        </div>

        <div class="settings-row">
          <div class="settings-row-left">
            <div class="settings-row-icon">🗄️</div>

            <div>
              <span class="settings-row-title">DATABASE_URL</span>
              <span class="settings-row-description">
                Đường dẫn kết nối PostgreSQL
              </span>
            </div>
          </div>

          <strong
            class="settings-value <%= databaseUrl ? 'configured' : 'warning' %>"
          >
            <%= databaseUrl ? 'Đã cấu hình' : 'Chưa cấu hình' %>
          </strong>
        </div>

        <div class="settings-row">
          <div class="settings-row-left">
            <div class="settings-row-icon">🔒</div>

            <div>
              <span class="settings-row-title">DATABASE_SSL</span>
              <span class="settings-row-description">
                Trạng thái SSL database
              </span>
            </div>
          </div>

          <strong class="settings-value">
            <%= String(databaseSsl) %>
          </strong>
        </div>

        <div class="settings-row">
          <div class="settings-row-left">
            <div class="settings-row-icon">🤖</div>

            <div>
              <span class="settings-row-title">BOT_TOKEN</span>
              <span class="settings-row-description">
                Kết nối Telegram Bot
              </span>
            </div>
          </div>

          <strong
            class="settings-value <%= botToken ? 'configured' : 'warning' %>"
          >
            <%= botToken ? 'Đã cấu hình' : 'Chưa cấu hình' %>
          </strong>
        </div>

        <div class="settings-row">
          <div class="settings-row-left">
            <div class="settings-row-icon">👤</div>

            <div>
              <span class="settings-row-title">ADMIN_USERNAME</span>
              <span class="settings-row-description">
                Tài khoản quản trị
              </span>
            </div>
          </div>

          <strong class="settings-value">
            <%= adminUsername %>
          </strong>
        </div>
      </div>
    </article>

    <article class="settings-card">
      <div class="settings-card-header">
        <div class="settings-card-icon">🩺</div>

        <div>
          <h3>Database health</h3>
          <p>Trạng thái kết nối PostgreSQL.</p>
        </div>
      </div>

      <div class="health-content">
        <div
          class="health-status <%= databaseConnected ? '' : 'disconnected' %>"
        >
          <span class="health-dot"></span>

          <div>
            <span class="health-label">Trạng thái</span>

            <strong class="health-value">
              <%= databaseConnected ? 'Connected' : 'Disconnected' %>
            </strong>
          </div>
        </div>

        <p class="health-message">
          <%= databaseMessage %>
        </p>

        <a class="health-link" href="/health" target="_blank">
          <span>Mở trang kiểm tra máy chủ</span>
          <code>/health</code>
        </a>

        <div class="settings-note">
          Thông tin nhạy cảm như mật khẩu database và BOT_TOKEN không được
          hiển thị trực tiếp trên trang này.
        </div>
      </div>
    </article>
  </section>
</div>

<%- include('partials/footer') %>