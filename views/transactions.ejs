<%- include('partials/header') %>

<section class="page-shell">
  <div class="group-header-card compact">
    <div>
      <span class="eyebrow">THU CHI</span>
      <h1>Giao dịch - <%= group.name %></h1>
      <p>Sửa hoặc xóa từng giao dịch.</p>
    </div>
    <a class="button button-light" href="/admin/groups/<%= group.id %>">Quay lại nhóm</a>
  </div>

  <nav class="section-tabs" aria-label="Chức năng nhóm">
    <a class="active" href="/admin/groups/<%= group.id %>">Thu chi</a>
    <a href="/admin/groups/<%= group.id %>/employees">Lương</a>
    <a href="/admin/groups/<%= group.id %>#group-settings">Cài đặt nhóm</a>
  </nav>

  <section class="content-card">
    <div class="card-heading"><div><h2>Tất cả giao dịch</h2><p><%= transactions.length %> giao dịch.</p></div></div>

    <% if (!transactions.length) { %>
      <div class="empty-state">Chưa có giao dịch.</div>
    <% } else { %>
      <div class="edit-list">
        <% transactions.forEach((transaction) => { %>
          <article class="edit-card" id="transaction-<%= transaction.id %>">
            <div class="edit-card-heading">
              <div>
                <span class="pill <%= transaction.type %>"><%= transaction.type === 'income' ? 'Thu' : 'Chi' %></span>
                <strong><%= transaction.description %></strong>
              </div>
              <strong class="money <%= transaction.type %>"><%= transaction.type === 'income' ? '+' : '-' %><%= formatCurrency(transaction.amount) %></strong>
            </div>

            <form method="post" action="/admin/transactions/<%= transaction.id %>/edit" class="form-stack" data-money-form>
              <div class="form-grid two">
                <label>
                  <span>Loại</span>
                  <select name="type">
                    <option value="income" <%= transaction.type === 'income' ? 'selected' : '' %>>Thu</option>
                    <option value="expense" <%= transaction.type === 'expense' ? 'selected' : '' %>>Chi</option>
                  </select>
                </label>
                <label>
                  <span>Số tiền</span>
                  <div class="money-field">
                    <input type="text" name="amount" inputmode="numeric" data-money-input value="<%= formatMoneyInput(transaction.amount) %>" required>
                    <span>đ</span>
                  </div>
                </label>
              </div>

              <label><span>Nội dung</span><textarea name="description" rows="2" required><%= transaction.description %></textarea></label>

              <div class="form-grid two">
                <label><span>Ngày</span><input type="date" name="transaction_date" value="<%= toDateInputValue(transaction.transaction_date) %>" required></label>
                <label><span>Giờ</span><input type="time" name="transaction_time" value="<%= formatTime(transaction.created_at) %>" data-local-time-source="<%= new Date(transaction.created_at).toISOString() %>" required></label>
              </div>
              <input type="hidden" name="timezone_offset" data-timezone-offset>

              <div class="button-row">
                <button class="button button-primary" type="submit">Lưu</button>
                <button class="button button-danger" type="submit" formaction="/admin/transactions/<%= transaction.id %>/delete" formmethod="post" data-confirm-button="Xóa giao dịch này?">Xóa</button>
              </div>
            </form>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</section>

<%- include('partials/footer') %>
