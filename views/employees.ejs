<%- include('partials/header') %>
<section class="page-header">
  <div>
    <h2>Nhân viên - <%= group.name %></h2>
    <p>Quản lý danh sách nhân viên và mức lương ngày.</p>
  </div>
  <a class="button secondary" href="/admin/groups/<%= group.id %>">Quay lại nhóm</a>
</section>

<section class="grid two-columns">
  <article class="card">
    <h3>Thêm nhân viên</h3>
    <form method="post" action="/admin/groups/<%= group.id %>/employees" class="stack">
      <label>
        Tên nhân viên
        <input type="text" name="name" required />
      </label>
      <label>
        Vai trò
        <input type="text" name="role" placeholder="VD: Thu ngân" />
      </label>
      <label>
        Lương ngày
        <input type="number" name="daily_rate" min="0" step="1000" value="0" required />
      </label>
      <button class="button" type="submit">Thêm nhân viên</button>
    </form>
  </article>

  <article class="card">
    <h3>Danh sách nhân viên</h3>
    <% if (!employees.length) { %>
      <p>Chưa có nhân viên.</p>
    <% } else { %>
      <div class="list compact">
        <% employees.forEach((employee) => { %>
          <a class="list-item" href="/admin/employees/<%= employee.id %>/salary">
            <div>
              <strong><%= employee.name %></strong>
              <small><%= employee.role || 'Chưa có vai trò' %></small>
            </div>
            <div class="meta">
              <span><%= formatCurrency(employee.daily_rate) %>/ngày</span>
              <span><%= employee.active ? 'Đang làm' : 'Ngừng' %></span>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </article>
</section>
<%- include('partials/footer') %>
