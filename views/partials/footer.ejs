  </main>

  <nav class="mobile-bottom-nav" aria-label="Điều hướng điện thoại">
    <a
      href="/admin/dashboard"
      class="mobile-nav-item"
      data-mobile-nav="/admin/dashboard"
    >
      <span class="mobile-nav-icon">⌂</span>
      <span>Dashboard</span>
    </a>

    <a
      href="/admin/groups"
      class="mobile-nav-item"
      data-mobile-nav="/admin/groups"
    >
      <span class="mobile-nav-icon">👥</span>
      <span>Nhóm</span>
    </a>

    <a
      href="/admin/settings"
      class="mobile-nav-item"
      data-mobile-nav="/admin/settings"
    >
      <span class="mobile-nav-icon">⚙</span>
      <span>Settings</span>
    </a>
  </nav>

  <div class="mobile-bottom-space"></div>

  <style>
    .mobile-bottom-nav,
    .mobile-bottom-space {
      display: none;
    }

    @media (max-width: 620px) {
      .mobile-bottom-nav {
        position: fixed;
        right: 13px;
        bottom: calc(12px + env(safe-area-inset-bottom));
        left: 13px;
        z-index: 100;

        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));

        min-height: 68px;
        padding: 7px;

        border: 1px solid rgba(148, 163, 184, 0.25);
        border-radius: 23px;

        background: rgba(255, 255, 255, 0.95);

        box-shadow:
          0 15px 40px rgba(15, 23, 42, 0.16),
          inset 0 1px 0 rgba(255, 255, 255, 0.8);

        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
      }

      .mobile-nav-item {
        display: flex;
        min-width: 0;
        min-height: 54px;

        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;

        border-radius: 17px;

        color: #64748b;

        font-size: 11px;
        font-weight: 750;
        text-decoration: none;
      }

      .mobile-nav-item:active {
        transform: scale(0.97);
      }

      .mobile-nav-icon {
        display: grid;

        width: 27px;
        height: 27px;

        place-items: center;

        font-size: 21px;
        line-height: 1;
      }

      .mobile-nav-item.active {
        background: #dcfce7;
        color: #15803d;
      }

      .mobile-bottom-space {
        display: block;
        height: calc(96px + env(safe-area-inset-bottom));
      }
    }
  </style>

  <script>
    (() => {
      const currentPath = window.location.pathname;

      document
        .querySelectorAll("[data-mobile-nav]")
        .forEach((link) => {
          const navPath = link.getAttribute("data-mobile-nav");

          const isActive =
            currentPath === navPath ||
            currentPath.startsWith(navPath + "/");

          link.classList.toggle("active", isActive);
        });
    })();
  </script>
</body>
</html>