<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0f7a43">
  <title><%= pageTitle || 'Thu Chi Lương Admin' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="app-header">
    <div class="app-header-inner">
      <a class="brand" href="/admin/dashboard">
        <span class="brand-mark">₫</span>
        <span>
          <strong>Thu Chi Lương</strong>
          <small>Quản lý trên điện thoại</small>
        </span>
      </a>

      <nav class="desktop-nav" aria-label="Điều hướng chính">
        <a href="/admin/dashboard" data-nav="/admin/dashboard">Trang chủ</a>
        <a href="/admin/groups" data-nav="/admin/groups">Nhóm</a>
        <a href="/admin/settings" data-nav="/admin/settings">Cài đặt</a>
      </nav>
    </div>
  </header>

  <main class="app-main">
    <% if (feedback?.success) { %>
      <div class="notice notice-success"><%= feedback.success %></div>
    <% } %>
    <% if (feedback?.warning) { %>
      <div class="notice notice-warning"><%= feedback.warning %></div>
    <% } %>
    <% if (feedback?.error) { %>
      <div class="notice notice-error"><%= feedback.error %></div>
    <% } %>
